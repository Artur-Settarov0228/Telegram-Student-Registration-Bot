# Telegram Personal Account Credentials (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_PHONE=+998901234567

# Google Sheets Configuration
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB_NAME=Registrations
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# Access Control (Comma-separated Telegram user IDs)
# EXCLUDED_USER_IDS: IDs that will never receive automated replies
EXCLUDED_USER_IDS=
# ALLOWED_USER_IDS: Optional allowlist; if set, only these IDs will be processed
ALLOWED_USER_IDS=

# Timezone for registration timestamps
TIMEZONE=Asia/Tashkent

# AI Model Configuration (Optional: for natural language understanding & extraction)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
